#include "vk_pipeline.h"


void createPipelineLayout(VkPipelineCtx* pipelineCtx,VkDeviceCtx* deviceCtx,DescriptorCtx* descriptorCtx){
  //Pipeline layout
  VkPipelineLayoutCreateInfo pipelineLayoutInfo = {0};
  pipelineLayoutInfo.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
  pipelineLayoutInfo.setLayoutCount = 1; // Optional
  pipelineLayoutInfo.pSetLayouts = &(descriptorCtx->layout); // Optional
  pipelineLayoutInfo.pushConstantRangeCount = 0; // Optional
  pipelineLayoutInfo.pPushConstantRanges = NULL; // Optional
  if(vkCreatePipelineLayout(deviceCtx->device, &pipelineLayoutInfo,NULL, &(pipelineCtx->pipelineLayout)) != VK_SUCCESS) {
    fprintf(stderr,"failed to create pipeline layout!\n");
    exit(EXIT_FAILURE);
  }
}

void createCommonStateDescriptions(pipelineStateDescriptions* desc,VkSwapchainCtx* swapChainCtx){
  //Viewports and scissors
  //VkViewport viewport = {0};
  desc->viewport.x = 0.0f;
  desc->viewport.y = 0.0f;
  desc->viewport.width = (float) swapChainCtx->swapChainExtent.width;
  desc->viewport.height = (float) swapChainCtx->swapChainExtent.height;
  desc->viewport.minDepth = 0.0f;
  desc->viewport.maxDepth = 1.0f;

  //VkRect2D scissor = {0};
  desc->scissor.offset.x = 0;
  desc->scissor.offset.y = 0;
  desc->scissor.extent = swapChainCtx->swapChainExtent;

  VkDynamicState* dynamicStates = (VkDynamicState*)malloc(sizeof(VkDynamicState)*2);
  dynamicStates[0] = VK_DYNAMIC_STATE_VIEWPORT;
  dynamicStates[1] = VK_DYNAMIC_STATE_SCISSOR;
 
  int dynamicStatesCount = 2;
  // VkPipelineDynamicStateCreateInfo dynamicState = {0};
  desc->dynamicState.sType = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO;
  desc->dynamicState.dynamicStateCount = (uint32_t)dynamicStatesCount;
  desc->dynamicState.pDynamicStates = dynamicStates;

  // VkPipelineViewportStateCreateInfo viewportState = {0};
  desc->viewportState.sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO;
  desc->viewportState.viewportCount = 1;
  //viewportState.pViewports = &viewport;
  desc->viewportState.scissorCount = 1;
  //viewportState.pScissors = &scissor;

  //Rasterizer
  //VkPipelineRasterizationStateCreateInfo rasterizer = {0};
  desc->rasterizer.sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO;
  desc->rasterizer.depthClampEnable = VK_FALSE;
  desc->rasterizer.rasterizerDiscardEnable = VK_FALSE;
  desc->rasterizer.polygonMode = VK_POLYGON_MODE_FILL;
  desc->rasterizer.lineWidth = 1.0f;
  desc->rasterizer.cullMode = VK_CULL_MODE_NONE;//VK_CULL_MODE_BACK_BIT;//VK_CULL_MODE_BACK_BIT;
  desc->rasterizer.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;//VK_FRONT_FACE_CLOCKWISE;
  desc->rasterizer.depthBiasEnable = VK_FALSE;
  desc->rasterizer.depthBiasConstantFactor = 0.0f; // Optional
  desc->rasterizer.depthBiasClamp = 0.0f; // Optional
  desc->rasterizer.depthBiasSlopeFactor = 0.0f; // Optional

  //DEPTH
  //VkPipelineDepthStencilStateCreateInfo depthStencil = {0};
  desc->depthStencil.sType = VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO;
  desc->depthStencil.depthTestEnable = VK_TRUE;
  desc->depthStencil.depthWriteEnable = VK_TRUE;
  desc->depthStencil.depthCompareOp = VK_COMPARE_OP_LESS;

  //Multisampling
  //VkPipelineMultisampleStateCreateInfo multisampling = {0};
  desc->multisampling.sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO;
  desc->multisampling.sampleShadingEnable = VK_FALSE;
  desc->multisampling.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
  desc->multisampling.minSampleShading = 1.0f; // Optional
  desc->multisampling.pSampleMask = NULL; // Optional
  desc->multisampling.alphaToCoverageEnable = VK_FALSE; // Optional
  desc->multisampling.alphaToOneEnable = VK_FALSE; // Optional

  // Color blending
  desc->colorBlendAttachment.colorWriteMask = VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT | VK_COLOR_COMPONENT_B_BIT | VK_COLOR_COMPONENT_A_BIT;
  desc->colorBlendAttachment.blendEnable = VK_TRUE;
  desc->colorBlendAttachment.srcColorBlendFactor = VK_BLEND_FACTOR_ONE;
  desc->colorBlendAttachment.dstColorBlendFactor = VK_BLEND_FACTOR_ZERO;
  desc->colorBlendAttachment.colorBlendOp = VK_BLEND_OP_ADD;
  desc->colorBlendAttachment.srcAlphaBlendFactor = VK_BLEND_FACTOR_ONE;
  desc->colorBlendAttachment.dstAlphaBlendFactor = VK_BLEND_FACTOR_ZERO;
  desc->colorBlendAttachment.alphaBlendOp = VK_BLEND_OP_ADD;

  //VkPipelineColorBlendStateCreateInfo colorBlending = {0};
  desc->colorBlending.sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO;
  desc->colorBlending.logicOpEnable = VK_FALSE;
  desc->colorBlending.logicOp = VK_LOGIC_OP_COPY;//Optional
  desc->colorBlending.attachmentCount = 1;
  desc->colorBlending.pAttachments = &(desc->colorBlendAttachment);
  desc->colorBlending.blendConstants[0] = 0.0f; // Optional
  desc->colorBlending.blendConstants[1] = 0.0f; // Optional
  desc->colorBlending.blendConstants[2] = 0.0f; // Optional
  desc->colorBlending.blendConstants[3] = 0.0f; // Optional
}

void createGraphicsPipeline(VkPipelineCtx* pipelineCtx,VkSwapchainCtx* swapChainCtx,VkDeviceCtx* deviceCtx,DescriptorCtx* descriptorCtx){
  pipelineStateDescriptions stateDescriptions = {0};
  createCommonStateDescriptions(&stateDescriptions,swapChainCtx);

  createTrianglePipeline(&stateDescriptions,pipelineCtx,deviceCtx);
  createLinePipeline(&stateDescriptions,pipelineCtx,deviceCtx);
  
}

void createRenderPass(VkPipelineCtx* pipelineCtx,VkSwapchainCtx* swapChainCtx,VkDeviceCtx* deviceCtx){
  VkAttachmentDescription colorAttachments[2];
  colorAttachments[0].format = swapChainCtx->swapChainImageFormat;
  colorAttachments[0].samples = VK_SAMPLE_COUNT_1_BIT;
  colorAttachments[0].loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
  colorAttachments[0].storeOp = VK_ATTACHMENT_STORE_OP_STORE;
  colorAttachments[0].stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
  colorAttachments[0].stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
  colorAttachments[0].initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
  colorAttachments[0].finalLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR;

  colorAttachments[1].format = VK_FORMAT_D32_SFLOAT;
  colorAttachments[1].samples = VK_SAMPLE_COUNT_1_BIT;
  colorAttachments[1].loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
  colorAttachments[1].storeOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
  colorAttachments[1].stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
  colorAttachments[1].stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
  colorAttachments[1].initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
  colorAttachments[1].finalLayout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;

  VkAttachmentReference colorAttachmentRef;
  colorAttachmentRef.attachment = 0;
  colorAttachmentRef.layout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;

  VkAttachmentReference depthAttachmentRef;
  depthAttachmentRef.attachment = 1;
  depthAttachmentRef.layout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
  
  VkSubpassDescription subpass = {0};
  subpass.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
  subpass.colorAttachmentCount = 1;
  subpass.pColorAttachments = &colorAttachmentRef;
  //subpass.depthAttachmentCount = 1;
  subpass.pDepthStencilAttachment = &depthAttachmentRef;


  // THE Render pass
  //subpass dependencies
  VkSubpassDependency dependency = {0};
  dependency.srcSubpass = VK_SUBPASS_EXTERNAL;
  dependency.dstSubpass = 0;
  dependency.srcStageMask = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT;
  dependency.srcAccessMask = 0;
  dependency.dstStageMask = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT;
  dependency.dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
  
  VkRenderPassCreateInfo renderPassInfo = {0};
  renderPassInfo.sType = VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO;
  renderPassInfo.attachmentCount = 2;
  renderPassInfo.pAttachments = colorAttachments;
  renderPassInfo.subpassCount = 1;
  renderPassInfo.pSubpasses = &subpass;
  renderPassInfo.dependencyCount = 1;
  renderPassInfo.pDependencies = &dependency;
  if(vkCreateRenderPass(deviceCtx->device, &renderPassInfo,NULL, &(pipelineCtx->renderPass)) != VK_SUCCESS){
    fprintf(stderr,"failed to create render pass!\n");
    exit(EXIT_FAILURE);
  }
}

void createFramebuffers(VkPipelineCtx* pipelineCtx,VkSwapchainCtx* swapChainCtx,VkDeviceCtx* deviceCtx){
  pipelineCtx->frameBuffers = (VkFramebuffer*)calloc(swapChainCtx->imageCount,sizeof(VkFramebuffer));
  pipelineCtx->frameBufferCount = swapChainCtx->imageCount;
  for(uint32_t i=0;i<swapChainCtx->imageCount;i++){
    VkImageView attachments[] = {
      swapChainCtx->swapChainImageViews[i],
      swapChainCtx->depthImageView
    };
    VkFramebufferCreateInfo framebufferInfo = {0};
    framebufferInfo.sType = VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO;
    framebufferInfo.renderPass = pipelineCtx->renderPass;
    framebufferInfo.attachmentCount = 2;
    framebufferInfo.pAttachments = attachments;
    framebufferInfo.width = swapChainCtx->swapChainExtent.width;
    framebufferInfo.height = swapChainCtx->swapChainExtent.height;
    framebufferInfo.layers = 1;
    if(vkCreateFramebuffer(deviceCtx->device,&framebufferInfo,NULL,&(pipelineCtx->frameBuffers[i])) != VK_SUCCESS){
      fprintf(stderr,"failed to create frame buffer!  index  = %d \n",i);
      exit(EXIT_FAILURE);
    }
  }
}

void createPipelineCtx(VkPipelineCtx* pipelineCtx,VkSwapchainCtx* swapChainCtx,VkDeviceCtx* deviceCtx,DescriptorCtx* descriptorCtx){
  createRenderPass(pipelineCtx,swapChainCtx,deviceCtx);
  createPipelineLayout(pipelineCtx,deviceCtx,descriptorCtx);
  createGraphicsPipeline(pipelineCtx,swapChainCtx,deviceCtx,descriptorCtx);
  createFramebuffers(pipelineCtx,swapChainCtx,deviceCtx);
}


void cleanupPipelineCtx(VkPipelineCtx* pipelineCtx,VkDeviceCtx* deviceCtx){
  for(uint32_t i=0;i<pipelineCtx->frameBufferCount;i++){
    vkDestroyFramebuffer(deviceCtx->device,pipelineCtx->frameBuffers[i],NULL);
  }
  vkDestroyPipeline(deviceCtx->device,pipelineCtx->trianglePipeline,NULL);
  vkDestroyPipeline(deviceCtx->device,pipelineCtx->linePipeline,NULL);
  vkDestroyPipelineLayout(deviceCtx->device,pipelineCtx->pipelineLayout,NULL);
  vkDestroyRenderPass(deviceCtx->device, pipelineCtx->renderPass,NULL);
}
