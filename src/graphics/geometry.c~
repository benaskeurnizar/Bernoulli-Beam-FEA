void updateBeamVertices(World* world,Mesh* mesh,BeamElement* beam){
  float raduis = sqrtf(world->sections[beam->sec_id].A/M_PI);
  vec3 center1;
  Node node1 = world->nodes[beam->node1];
  center1[0] = node1.x;center1[1] = node1.y;center1[2] = node1.z;

  vec3 center2;
  Node node2 = world->nodes[beam->node2];
  center2[0] = node2.x;center2[1] = node2.y;center2[2] = node2.z;

  //NOTE: GET AXIS
  vec3 worldUP;
  worldUP[0] = 0.0;worldUP[1] = 0.0;worldUP[2] = 1.0;
  vec3 forward;
  glm_vec_sub(center2,center1,forward);
  glm_vec_normalize(forward);
  if (fabsf(glm_vec_dot(forward, worldUP)) > 0.99f){
    worldUP[1] = 1.0; // avoid parallel case
    worldUP[2] = 0.0;
  }
  vec3 right,up;
  glm_vec_cross(forward,worldUP,up);glm_vec_normalize(up);
  glm_vec_cross(forward,up,right);glm_vec_normalize(right);
  
  int num_divisions = 10;
  float step = beam->Le/num_divisions;
  float* displacements = (float*)calloc(num_divisions+1,sizeof(float));
  for(int i=0;i<=num_divisions;i++){
    displacements[i] =  get_z_displacement(beam,i*step,beam->local_dis[1],beam->local_dis[5],beam->local_dis[7],beam->local_dis[11]);
  }
  int outline_count;
  point2D* outline_points = createCircleOutline(raduis*2.0,0.5,&outline_count);

  int rings_count = num_divisions+1;
  vec3** rings = (vec3**)malloc(sizeof(vec3*)*rings_count);
  int ring_count = outline_count;
  vec3 dis_dir = {0.0,0.0,-1.0};
  for(int i=0;i<rings_count;i++){
    rings[i] = (vec3*)malloc(sizeof(vec3)*ring_count);
    vec3 temp,current_center,center;
    glm_vec_copy(center1,current_center);
    current_center[0]+=i*step;
    glm_vec_scale(dis_dir,displacements[i]*100.0,temp);
    glm_vec_add(current_center,temp,center);
    for(int j=0;j<outline_count;j++){
      float u = outline_points[j].u;
      float v = outline_points[j].v;
      rings[i][j][0] = center[0]+u*right[0]+v*up[0];
      rings[i][j][1] = center[1]+u*right[1]+v*up[1];
      rings[i][j][2] = center[2]+u*right[2]+v*up[2];
    }
  }
  free(mesh->vertices);
  free(mesh->indices);
  
  mesh->vertexCount = 6*outline_count*num_divisions + (ring_count*2*3);// vertices linking rings together, and the 2 outer rings
  mesh->vertices = (Vertex*)calloc(mesh->vertexCount,sizeof(Vertex));
  mesh->indexCount = 6*outline_count*num_divisions + (ring_count*2*3);
  mesh->indices = (uint32_t*)calloc(mesh->indexCount,sizeof(uint32_t));
  
  int idx = 0;
  vec3 color;
  color[0] = 1.0;color[1] = 0.0;color[2] = 0.0;
  Vertex vertex ;
  glm_vec_copy(color, vertex.color);
  glm_vec_copy((vec3){1,0,0}, vertex.normal);
  //NOTE: first ring
  for(int i=0;i<ring_count-1;i++){
    //the center
    glm_vec_copy(center1,vertex.pos);
     memcpy(mesh->vertices+(idx),&vertex,sizeof(Vertex));
    mesh->indices[(idx)] = (uint32_t)(idx);
    idx++;

    // i
    glm_vec_copy(rings[0][i],vertex.pos);
    memcpy(mesh->vertices+(idx),&vertex,sizeof(Vertex));
    mesh->indices[(idx)] = (uint32_t)(idx);
    idx++;

    // i+1
    glm_vec_copy(rings[0][i+1],vertex.pos);
    memcpy(mesh->vertices+(idx),&vertex,sizeof(Vertex));
    mesh->indices[(idx)] = (uint32_t)(idx);
    idx++;
  }
  color[0] = 0.0;color[1] = 0.0;color[2] = 1.0;
  glm_vec_copy(color, vertex.color);
  for(int i=0;i<ring_count-1;i++){
    //the center
    glm_vec_copy(center2,vertex.pos);
     memcpy(mesh->vertices+(idx),&vertex,sizeof(Vertex));
    mesh->indices[(idx)] = (uint32_t)(idx);
    idx++;

    // i
    glm_vec_copy(rings[rings_count-1][i],vertex.pos);
    memcpy(mesh->vertices+(idx),&vertex,sizeof(Vertex));
    mesh->indices[(idx)] = (uint32_t)(idx);
    idx++;

    // i+1
    glm_vec_copy(rings[rings_count-1][i+1],vertex.pos);
    memcpy(mesh->vertices+(idx),&vertex,sizeof(Vertex));
    mesh->indices[(idx)] = (uint32_t)(idx);
    idx++;
  }
  for(int i=0;i<num_divisions;i++){
    meshConnectRings(mesh,&idx,outline_count,rings[i],rings[i+1]);
  }
  world->update_beam_buffers = 1;
  
}

