void rotate_vectorX(vec3 a,float theta,vec3 d){
  d[0] = a[0];
  d[1] = cosf(theta)*a[1] + (-sinf(theta)*a[2]);
  d[2] = sinf(theta)*a[1] + cosf(theta)*a[2];
}

vec3* circleVertices(vec3 center,int* verticesCount,float raduis){
  //NOTE: SCALE THE RADUIS BY 4
  raduis*=4.0;
  float theta = 0.0;
  const float DthetaDeg = 0.1f;
  int N = (int)(360.0f / DthetaDeg + 0.5f); // round, don't truncate
  *verticesCount = 3*N;
  vec3* vertices = (vec3*)calloc(*verticesCount,sizeof(vec3));
  vec3 firstPoint;
  firstPoint[0] = center[0];firstPoint[1] = center[1];firstPoint[2] = center[2]+raduis;

  vec3 vector;
  glm_vec_sub(firstPoint,center,vector);
  int vertices_index = 0;
  for(int i=0;i<N;i++){
    float theta1 = glm_rad(i*DthetaDeg);
    float theta2 = glm_rad((i+1)%N * DthetaDeg);
    vec3 temp;
    glm_vec_copy(vector,temp);
    rotate_vectorX(temp,theta1,vector);
    //float theta2 = theta+Dtheta;
    vec3 point1;
    glm_vec_add(center,vector,point1);
    vec3 point2,vector2;
    rotate_vectorX(vector,theta2,vector2);
    glm_vec_add(center,vector2,point2);
    
    glm_vec_copy(center,vertices[vertices_index++]);
    glm_vec_copy(point1,vertices[vertices_index++]);
    glm_vec_copy(point2,vertices[vertices_index++]);
  }
  return vertices;
}

