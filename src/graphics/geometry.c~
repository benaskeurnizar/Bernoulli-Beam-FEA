Vertex* createMeshedCircle(World* world,BeamElement* beam,float raduis,float* stressValues,int stress_count,vec3 center,vec3 up,vec3 right,int* count){
  int num_divisions = 10;
  //NOTE: CREATE INNER RINGS
  int rings_count = num_divisions;
  Vertex** vertex_rings = (Vertex**)malloc(sizeof(Vertex*)*rings_count);
  int* rings_sizes = (int*)malloc(sizeof(int)*rings_count);
  for(int i=0;i<num_divisions;i++){
    float r = raduis/(num_divisions-(float)(i));
    int outline_count = 0;
    point2D* points_outline = createCircleOutline(r,0.1,&outline_count);
    vertex_rings[i] = convertOutlineVertices(world,beam,points_outline,outline_count,r,center,up,right,stressValues,stress_count,&(rings_sizes[i]));
    free(points_outline);
  }

  //NOTE: NOW CONNECT THOSE RINGS INTO ONE MESH
  int result_count = ((rings_count-1)*(*rings_sizes)*6)+(3*(*rings_sizes));//TODO: figure this out
  Vertex* result = (Vertex*)calloc(result_count,sizeof(Vertex));
  int idx = 0;
  for(int i=0;i<rings_count-1;i++){
    int current_ring = i;
    int next_ring = i+1;
    for(int j=0;j<(*rings_sizes);j++){
      int next_j = (j+1)%(*rings_sizes);
      //TODO: COPY THE VERTEX,DON'T JUST WRITE IT
      result[idx++] = vertex_rings[current_ring][j];
      result[idx++] = vertex_rings[next_ring][j];
      result[idx++] = vertex_rings[current_ring][next_j];

      result[idx++] = vertex_rings[current_ring][next_j];
      result[idx++] = vertex_rings[next_ring][j];
      result[idx++] = vertex_rings[next_ring][next_j];
    }
  }
  //NOTE: last ring with center
  Section section = world->sections[beam->sec_id];
  Material material = world->materials[beam->mat_id];
  float y = 0.0;
  float z = 0.0;
  float sigma = (stressValues[0]/section.A);
  float t =(sigma-sigma_min)/(sigma_max-sigma_min);
  Vertex center_vert;
  vec3 normal;
  normal[0] = 0.0;normal[1] = 0.0;normal[2] = 1.0;
  glm_vec_copy(normal,center_vert.normal);
  glm_vec_copy(center,center_vert.pos);
  vec3 color;
  if(t>=1.0){
    t = 1.0;
  }
  if(t<0.0){
    t=0.0;
  }
  if(t<0.5){
    color[0] = 2*t;color[1] = 2*t;color[2] = 1.0;
  }else{
    color[0] = 1.0;color[1] = 2*(1.0-t);color[2] = 2*(1.0-t);
  }
  glm_vec_copy(color,center_vert.color);
  for(int i=0;i<(*rings_sizes);i++){
    int next_i = (i+1)%(*rings_sizes);
    result[idx++] = center_vert;
    result[idx++] = vertex_rings[rings_count-1][i];
    result[idx++] = vertex_rings[rings_count-1][next_i];
  }
  *count = result_count;
  for(int i=0;i<rings_count;i++){
    free(vertex_rings[i]);
  }
  free(vertex_rings);
  return result;
}



void beamCrossSection(World* world,Mesh* mesh,BeamElement* beam){
  Section section = world->sections[beam->sec_id];
  Material material = world->materials[beam->mat_id];
  
  float raduis = sqrtf(world->sections[beam->sec_id].A/M_PI);
  vec3 center1;
  Node node1 = world->nodes[beam->node1];
  center1[0] = node1.x;center1[1] = node1.y;center1[2] = node1.z;

  vec3 center2;
  Node node2 = world->nodes[beam->node2];
  center2[0] = node2.x;center2[1] = node2.y;center2[2] = node2.z;

  //NOTE: GET AXIS
  vec3 worldUP;
  worldUP[0] = 0.0;worldUP[1] = 0.0;worldUP[2] = 1.0;
  vec3 forward;
  glm_vec_sub(center2,center1,forward);
  glm_vec_normalize(forward);
  if (fabsf(glm_vec_dot(forward, worldUP)) > 0.99f){
    worldUP[1] = 1.0; // avoid parallel case
    worldUP[2] = 0.0;
  }
  vec3 right,up;
  glm_vec_cross(forward,worldUP,up);glm_vec_normalize(up);
  glm_vec_cross(forward,up,right);glm_vec_normalize(right);
  
  //NOTE: for outer cross sections,we mesh the whole circles,otherwise, just the outer parts
  //NOTE: FIRST MESHED CIRCLE
  float last_disp = get_z_displacement(beam,beam->Le,beam->local_dis[1],beam->local_dis[5],beam->local_dis[7],beam->local_dis[11]);
  int stress_count = 0;
  float* cercle1_stresses =  getSectionStress(world,beam,0.0,&stress_count);
  int circle1_count = 0;
  Vertex* circle1_vertices = createMeshedCircle(world,beam,raduis*2.0,cercle1_stresses,stress_count,center1,up,right,&circle1_count);
  //NOTE: SECOND MESHED CIRCLE
  float* circle2_stresses =  getSectionStress(world,beam,1.0,&stress_count);
  int circle2_count = 0;
  vec3 center2_dis,temp;
  vec3 dis_dir = {0.0,0.0,-1.0};
  glm_vec_scale(dis_dir,last_disp*100.0,temp);
  glm_vec_add(center2,temp,center2_dis);
  Vertex* circle2_vertices = createMeshedCircle(world,beam,raduis*2.0,circle2_stresses,stress_count,center2_dis,up,right,&circle2_count);

  //NOTE: NOW DO THE OTHER CIRLCES
  int num_divisions = 10;
  float step = beam->Le/num_divisions;
  float* displacements = (float*)calloc(num_divisions+1,sizeof(float));
  for(int i=0;i<=num_divisions;i++){
    displacements[i] =  get_z_displacement(beam,i*step,beam->local_dis[1],beam->local_dis[5],beam->local_dis[7],beam->local_dis[11]);
  }

  int outline_count;
  point2D* outline_points = createCircleOutline(raduis*2.0,0.5,&outline_count);

  int rings_count = num_divisions+1;
  Vertex** rings = (Vertex**)malloc(sizeof(Vertex*)*rings_count);
  int ring_count = outline_count;
  //vec3 dis_dir = {0.0,0.0,-1.0};
  Vertex vert = {0};
  vec3 color;
  for(int i=0;i<rings_count;i++){
    int point_stress_count = 0;
    float* point_stresses =  getSectionStress(world,beam,(i*step)/beam->Le,&point_stress_count);
    rings[i] = (Vertex*)malloc(sizeof(Vertex)*ring_count);
    vec3 temp,current_center,center;
    glm_vec_copy(center1,current_center);
    current_center[0]+=i*step;
    glm_vec_scale(dis_dir,displacements[i]*100.0,temp);
    glm_vec_add(current_center,temp,center);
    for(int j=0;j<outline_count;j++){
      float u = outline_points[j].u;
      float v = outline_points[j].v;
      float y = u*raduis;
      float z = v*raduis;
      float sigma = (point_stresses[0]/section.A)+(-point_stresses[5]*y/section.Iz)+(point_stresses[4]*z/section.Iy);
      float t =(sigma-sigma_min)/(sigma_max-sigma_min);
      if(t>=1.0){
	t = 1.0;
      }
      if(t<0.0){
	t=0.0;
      }
      if(t<0.5){
	color[0] = 2*t;color[1] = 2*t;color[2] = 1.0;
      }else{
	color[0] = 1.0;color[1] = 2*(1.0-t);color[2] = 2*(1.0-t);
      }
      glm_vec_copy(color,vert.color);
      glm_vec_copy(vert.color,rings[i][j].color);
      rings[i][j].pos[0] = center[0]+u*right[0]+v*up[0];
      rings[i][j].pos[1] = center[1]+u*right[1]+v*up[1];
      rings[i][j].pos[2] = center[2]+u*right[2]+v*up[2];
      glm_vec_copy(vert.normal,rings[i][j].normal);
    }
    free(point_stresses);
  }
  free(mesh->vertices);
  free(mesh->indices);

  //NOTE: NOW CREATE THE RESULTED VERTICES
  int idx = 0;
  mesh->vertexCount = 6*outline_count*num_divisions + (circle1_count+circle2_count);
  mesh->vertices = (Vertex*)calloc(mesh->vertexCount,sizeof(Vertex));
  mesh->indexCount = 6*outline_count*num_divisions + (circle1_count+circle2_count);
  mesh->indices = (uint32_t*)calloc(mesh->indexCount,sizeof(uint32_t));

  memcpy(mesh->vertices+idx,circle1_vertices,circle1_count*sizeof(Vertex));
  for(int i=0;i<circle1_count;i++){
    mesh->indices[i] = i;
  }
  idx+=circle1_count;
  memcpy(mesh->vertices+idx,circle2_vertices,circle2_count*sizeof(Vertex));
  for(int i=idx;i<idx+circle2_count;i++){
    mesh->indices[i] = i;
  }
  idx+=circle2_count;
  for(int i=0;i<num_divisions;i++){
    meshConnectRingsVertex(mesh,&idx,outline_count,rings[i],rings[i+1]);
  }
  world->update_beam_buffers = 1;
  free(circle1_vertices);
  free(circle2_vertices);
  for(int i=0;i<rings_count;i++){
    free(rings[i]);
  }
  free(rings);
}


Vertex* convertOutlineVertices(World* world,BeamElement* beam,point2D* outline_points,int outline_count,float raduis,vec3 center1,vec3 up,vec3 right,float* stressValues,int stress_count,int* return_size){
  Section section = world->sections[beam->sec_id];
  Material material = world->materials[beam->mat_id];
  *return_size = outline_count;
  Vertex* vertices = (Vertex*)calloc(*return_size,sizeof(Vertex));
  vec3 temp,current_center,center;
  glm_vec_copy(center1,center);
  int idx = 0;
  Vertex vert = {0};
  vec3 normal;
  normal[0] = 0.0;normal[1] = 0.0;normal[2] = 1.0;
  glm_vec_copy(normal,vert.normal);
  vec3 color;
  glm_vec_zero(color);
  for(int j=0;j<outline_count;j++){
    float u = outline_points[j].u;
    float v = outline_points[j].v;
    vert.pos[0] = center[0]+u*right[0]+v*up[0];
    vert.pos[1] = center[1]+u*right[1]+v*up[1];
    vert.pos[2] = center[2]+u*right[2]+v*up[2];
    float y = u*raduis;
    float z = v*raduis;
    float sigma = (stressValues[0]/section.A)+(-stressValues[5]*y/section.Iz)+(stressValues[4]*z/section.Iy);
    float t =(sigma-sigma_min)/(sigma_max-sigma_min);
    if(t>=1.0){
      t = 1.0;
    }
    if(t<0.0){
      t=0.0;
    }
    if(t<0.5){
      color[0] = 2*t;color[1] = 2*t;color[2] = 1.0;
    }else{
      color[0] = 1.0;color[1] = 2*(1.0-t);color[2] = 2*(1.0-t);
    }
    vec3 test_color;
    glm_vec_zero(test_color);
    test_color[1] = 1.0;
    glm_vec_copy(color,vert.color);
    memcpy(vertices+idx,&vert,sizeof(Vertex));
    idx++;
  }
  return vertices;
}
