typedef enum{
  VERTEX,
  TEXTURE,
  NORMAL,
  FACE,
  UNKNOWN,
}lineType;

lineType getLineType(char* line){
  if(!line){
    return UNKNOWN;
  }
  if (line[0] == '\0')
    return UNKNOWN;

  if (line[1] == '\0')
    return UNKNOWN;
  char first = line[0];
  char second = line[1];
  if(first == 'v'){
    if(second == ' '){
      return VERTEX;
    }else if(second == 't'){
      return TEXTURE;
    }else if(second == 'n'){
      return NORMAL;
    }
  }else if(first == 'f'){
    if(second == ' '){
      return FACE;
    }
  }
  return UNKNOWN;
}

vec3 parseVertexLine(char* line){
  int index = 0;
  int size = 32;
  char* current_char = (char*)calloc(size,sizeof(char));
  int char_index = 0;

  char* end = NULL;

  vec3 vertex;
  glm_vec_zero(vertex);
  int vertex_index = 0;
  while(line[index] != '\0'){
    if(line[index] == '-' || line[index] == '.' || (line[index] >= 48 && line[index] <= 57)){
      current_char[char_index++] = line[index];
    }
    if((line[index] == ' ' && char_index>0) || (char_index >= size-1)){
      current_char[char_index] = '\0';
      float value = strtof (current_char,&end);
      if(vertex_index >= 3){
	free(current_char);
	return vertex;
      }
      vertex[vertex_index++] = value;
      memset(current_char,0,size*sizeof(char));
      char_index = 0;
    }
    index++;
  }
  if(vertex_index < 3){
    if(char_index > 0){
      current_char[char_index] = '\0';
      float value = strtof (current_char,&end);
      vertex[vertex_index++] = value;
    }
  }
  free(current_char);
  return vertex;
}

