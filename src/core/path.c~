#include "path.h"

AppPaths globalPaths = {0};

void initPaths(){
  if(!GetModuleFileNameA(NULL,globalPaths.root,APP_PATH_MAX)){
    fprintf(stderr,"failed to get global paths\n");
    exit(EXIT_FAILURE);
  }
  strcpy(globalPaths.assets,globalPaths.root);
  strcpy(globalPaths.shaders,globalPaths.root);
  // set asset dir
  int root_len = strlen(globalPaths.root);
  int sep_count = 0;
  int asset_index = 0,shader_index = 0;;
  for(int i=root_len-1;i>=0;i--){
    if(globalPaths.root[i]==PATH_SEP){
      sep_count++;
    }
    if(sep_count == 2){
      asset_index = i+1;
      shader_index = i+1;
      break;
    }
  }
  globalPaths.assets[asset_index++] = 'a';globalPaths.assets[asset_index++] = 's';globalPaths.assets[asset_index++] = 's';globalPaths.assets[asset_index++] = 'e';
  globalPaths.assets[asset_index++] = 't';globalPaths.assets[asset_index++] = 's';globalPaths.assets[asset_index++] = '\0';

  //set shaders dir
  globalPaths.shaders[shader_index++] = 's';globalPaths.shaders[shader_index++] = 'h';globalPaths.shaders[shader_index++] = 'a';globalPaths.shaders[shader_index++] = 'd';
  globalPaths.shaders[shader_index++] = 'e';globalPaths.shaders[shader_index++] = 'r';globalPaths.shaders[shader_index++] = 's';globalPaths.shaders[shader_index++] = '\0';
}
